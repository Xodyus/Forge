{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 26, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug",
      "description": "Debug symbols, assertions, high warnings (§254 dev-debug). Builds bindings, tests, and bench.",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "FORGE_BUILD_BINDINGS": "ON",
        "FORGE_BUILD_TESTS": "ON",
        "FORGE_BUILD_BENCH": "ON",
        "FORGE_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "description": "Optimized build (§254 dev-release / benchmark). Builds bindings, tests, and bench.",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "FORGE_BUILD_BINDINGS": "ON",
        "FORGE_BUILD_TESTS": "ON",
        "FORGE_BUILD_BENCH": "ON",
        "FORGE_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "asan",
      "displayName": "AddressSanitizer",
      "description": "§254 asan-ubsan (address half). GCC/Clang only — MSVC uses different sanitizer flags and is not supported by this preset. Bindings are skipped: sanitizing the Python extension requires a matching sanitizer-built CPython, which is out of scope for this scaffold.",
      "inherits": "debug",
      "cacheVariables": {
        "FORGE_BUILD_BINDINGS": "OFF",
        "CMAKE_CXX_FLAGS": "-fsanitize=address -fno-omit-frame-pointer -g -O1",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address"
      }
    },
    {
      "name": "ubsan",
      "displayName": "UndefinedBehaviorSanitizer",
      "description": "§254 asan-ubsan (undefined-behavior half). GCC/Clang only — see the asan preset description. Bindings are skipped for the same reason.",
      "inherits": "debug",
      "cacheVariables": {
        "FORGE_BUILD_BINDINGS": "OFF",
        "CMAKE_CXX_FLAGS": "-fsanitize=undefined -fno-omit-frame-pointer -g -O1",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=undefined"
      }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "debug" },
    { "name": "release", "configurePreset": "release" },
    { "name": "asan", "configurePreset": "asan" },
    { "name": "ubsan", "configurePreset": "ubsan" }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    },
    {
      "name": "asan",
      "configurePreset": "asan",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    },
    {
      "name": "ubsan",
      "configurePreset": "ubsan",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    }
  ]
}
